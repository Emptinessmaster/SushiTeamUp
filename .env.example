# Configurazione Firebase.
# Copia questo file in ".env" e inserisci i valori del tuo progetto Firebase.
# Li trovi in: Console Firebase > Impostazioni progetto > Le tue app > Web app > SDK setup and configuration.
#
# NB: queste chiavi Web NON sono segrete: identificano il progetto lato client.
# La sicurezza dei dati e' garantita dalle Regole di Firestore (vedi firestore.rules).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

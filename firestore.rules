rules_version = '2';

// Regole di sicurezza Firestore per SushiTeamUp.
// Pubblica queste regole con:  firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    // Una stanza è raggiungibile solo conoscendone il codice (l'ID documento).
    match /rooms/{roomId} {
      // Serve essere autenticati per leggere/entrare.
      allow read: if request.auth != null;

      // Solo un utente autenticato può creare la propria stanza.
      allow create: if request.auth != null
                    && request.resource.data.ownerId == request.auth.uid;

      // Aggiornamenti (es. aggiungersi ai membri, incrementare nextRound)
      // consentiti a qualsiasi utente autenticato che conosce il codice.
      allow update: if request.auth != null;

      // Solo il proprietario può eliminare la stanza.
      allow delete: if request.auth != null
                    && resource.data.ownerId == request.auth.uid;

      // Ordini della stanza.
      match /orders/{orderId} {
        allow read: if request.auth != null;

        // Chi crea un ordine deve firmarlo con il proprio uid.
        allow create: if request.auth != null
                      && request.resource.data.createdBy == request.auth.uid;

        // Aggiornare (segna effettuato / riapri) o eliminare:
        // l'autore dell'ordine oppure il proprietario della stanza.
        allow update, delete: if request.auth != null
                              && (resource.data.createdBy == request.auth.uid
                                  || get(/databases/$(database)/documents/rooms/$(roomId)).data.ownerId == request.auth.uid);
      }
    }
  }
}
